# Atlas: Connect > Drivers. Replace the placeholders and keep /civicbridge.
# Percent-encode special characters in the username/password. Never commit the real URI.
DATABASE_URL="mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/civicbridge?retryWrites=true&w=majority&appName=CivicBridge"
AUTH_SECRET="replace-with-a-random-64-character-secret"
# Use the exact HTTPS application origin on your deployment host.
AUTH_URL="http://127.0.0.1:3000"
AUTH_TRUST_HOST="true"
# Required explicitly to seed the five local demo accounts. Never seed shared passwords in production.
DEMO_PASSWORD=""
ALLOW_DEMO_ACCOUNTS="false"
# Report assistance stays rule-based unless explicitly enabled and reviewed.
AI_CLASSIFIER_MODE="rules"
ALLOW_DEMO_MODEL="false"
# Optional; without these, assistance uses a labeled local heuristic.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4.1-mini"
